+++ b/tools/prepare-russian-ui.py
@@ -0,0 +1,60 @@
+#!/usr/bin/env python3
+"""生成俄语显示补丁；技术标识与用户内容不进入翻译边界。"""
+import json,argparse
+from pathlib import Path
+ROOT=Path(__file__).resolve().parents[1];ASSETS=ROOT/'app/src/main/assets'
+
+def generate():
