index 0000000..14dd7d3
--- /dev/null
+++ b/app/src/main/assets/russian-plugin-ui-patch.json
@@ -0,0 +1,65 @@
+{
+  "version": 1,
+  "dshVersion": "0.2.2-rc.1",
+  "module": "@deepseek-ai/dsh-client-ui-plugin-manager/lib/client.js",
+  "patches": [
+    {
